rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasRole(userId, role) {
      return isOwner(userId)
          && get(/databases/$(database)/documents/users/$(userId)).data.role == role;
    }

    function isApprovedSeller(userId) {
      return hasRole(userId, 'SELLER')
          && get(/databases/$(database)/documents/users/$(userId)).data.sellerStatus == 'APPROVED';
    }

    function isAdmin() {
      return isSignedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function ownsProduct(productId) {
      return isSignedIn()
          && get(/databases/$(database)/documents/products/$(productId)).data.sellerId == request.auth.uid;
    }

    function validProduct(data) {
      return data.name is string
          && data.name.size() >= 2
          && data.categoryId is string
          && data.categoryId.size() > 0
          && data.originalPrice is number
          && data.rescuePrice is number
          && data.originalPrice > 0
          && data.rescuePrice > 0
          && data.rescuePrice <= data.originalPrice
          && data.unit is string
          && data.unit.size() > 0
          && get(/databases/$(database)/documents/categories/$(data.categoryId)).data.active == true
          && data.status in ['ACTIVE', 'INACTIVE', 'SOLD_OUT', 'HIDDEN'];
    }

    function validBatch(data) {
      return data.initialQuantity is number
          && data.availableQuantity is number
          && data.reservedQuantity is number
          && data.soldQuantity is number
          && data.initialQuantity > 0
          && data.availableQuantity >= 0
          && data.reservedQuantity >= 0
          && data.soldQuantity >= 0
          && data.initialQuantity
              - (data.availableQuantity + data.reservedQuantity + data.soldQuantity) <= 0.000001
          && data.initialQuantity
              - (data.availableQuantity + data.reservedQuantity + data.soldQuantity) >= -0.000001
          && data.harvestDate is timestamp
          && data.expiryDate is timestamp
          && data.harvestDate < data.expiryDate
          && data.status in ['AVAILABLE', 'RESERVED_PARTIAL', 'SOLD_OUT', 'EXPIRED'];
    }

    function validPromotion(data, promotionId) {
      return data.id == promotionId
          && data.productId == promotionId
          && data.sellerId is string
          && data.type in ['PERCENT', 'FIXED', 'VOLUME']
          && data.value is number
          && data.value >= 0
          && (data.type == 'VOLUME' || data.value > 0)
          && (data.type != 'PERCENT' || data.value <= 100)
          && (data.type != 'VOLUME' || data.value == 0)
          && data.quantityDiscountTiers is map
          && data.quantityDiscountTiers.size() <= 10
          && (data.type != 'VOLUME' || data.quantityDiscountTiers.size() > 0)
          && data.startDate is timestamp
          && data.endDate is timestamp
          && data.startDate < data.endDate
          && data.active is bool;
    }

    function validCustomerCart(data, customerId) {
      return data.id == customerId
          && data.ownerKey == customerId
          && data.ownerType == 'CUSTOMER'
          && data.items is list
          && data.items.size() <= 100
          && data.updatedAt is timestamp
          && hasNoCredentialFields(data);
    }

    function validOrder(data, orderId) {
      return data.id == orderId && data.requestId == orderId
          && data.ownerType in ['GUEST', 'CUSTOMER'] && data.ownerId is string
          && data.sellerId is string && data.orderCode is string
          && data.fulfillmentType in ['DELIVERY', 'PICKUP', 'ON_SITE_RESCUE']
          && data.receiverName is string && data.receiverPhone is string
          && data.receiverPhone.size() >= 9 && data.receiverAddress is string
          && data.subtotal is number && data.subtotal >= 0
          && data.quantityDiscount is number && data.shippingFee is number
          && data.totalAmount is number && data.totalAmount >= 0
          && data.totalAmount == data.subtotal - data.quantityDiscount + data.shippingFee
          && data.paymentMethod in ['COD', 'BANK_TRANSFER', 'CASH_ON_SITE']
          && (data.paymentMethod == 'BANK_TRANSFER'
            || (data.fulfillmentType == 'DELIVERY' && data.paymentMethod == 'COD')
            || (data.fulfillmentType != 'DELIVERY' && data.paymentMethod == 'CASH_ON_SITE'))
          && data.paymentStatus in ['UNPAID', 'PENDING'] && data.status == 'PENDING'
          && data.campaignReservedQuantity is number && data.campaignReservedQuantity >= 0
          && data.batchReservations is map && data.batchReservations.size() > 0
          && data.batchReservations.size() <= 20
          && data.inventoryFinalized == false && data.finalizedStatus == ''
          && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function checkoutOwnerAllowed(order) {
      return (order.ownerType == 'CUSTOMER' && hasRole(order.ownerId, 'CUSTOMER'))
          || (order.ownerType == 'GUEST' && request.auth == null);
    }

    function checkoutBatchReservation(before, after, batchId) {
      let orderId = after.lastReservationOrderId;
      let order = getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
      let quantity = order.batchReservations[batchId];
      return order.status == 'PENDING' && checkoutOwnerAllowed(order)
          && ((before.activeCampaignId == null && order.campaignId == '')
            || before.activeCampaignId == '' && order.campaignId == ''
            || before.activeCampaignId == order.campaignId)
          && quantity is number && quantity > 0
          && after.availableQuantity == before.availableQuantity - quantity
          && after.reservedQuantity == before.reservedQuantity + quantity
          && after.soldQuantity == before.soldQuantity
          && after.initialQuantity == before.initialQuantity
          && after.inventoryVersion == before.inventoryVersion + 1
          && after.lastReservationQuantity == quantity
          && after.diff(before).affectedKeys().hasOnly([
            'availableQuantity', 'reservedQuantity', 'status', 'inventoryVersion',
            'lastReservationOrderId', 'lastReservationQuantity', 'updatedAt'
          ]);
    }

    function checkoutCampaignReservation(before, after) {
      let orderId = after.lastReservationOrderId;
      let order = getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
      return order.status == 'PENDING' && checkoutOwnerAllowed(order)
          && order.campaignId == before.id
          && order.campaignReservedQuantity > 0
          && after.reservedQuantity == before.reservedQuantity + order.campaignReservedQuantity
          && after.rescuedQuantity == before.rescuedQuantity
          && after.lastReservationQuantity == order.campaignReservedQuantity
          && after.diff(before).affectedKeys().hasOnly([
            'reservedQuantity', 'lastReservationOrderId', 'lastReservationQuantity', 'updatedAt'
          ]);
    }

    function lifecycleActor(order) {
      return (isApprovedSeller(request.auth.uid) && order.sellerId == request.auth.uid) || isAdmin();
    }

    function legalOrderStatusTransition(before, after) {
      return (before.status == 'PENDING' && after.status in ['CONFIRMED', 'CANCELLED'])
          || (before.status == 'CONFIRMED' && after.status in ['PREPARING', 'CANCELLED'])
          || (before.status == 'PREPARING' && after.status == 'CANCELLED')
          || (before.status == 'PREPARING' && before.fulfillmentType == 'DELIVERY' && after.status == 'SHIPPING')
          || (before.status == 'PREPARING' && before.fulfillmentType == 'PICKUP' && after.status == 'READY_FOR_PICKUP')
          || (before.status == 'PREPARING' && before.fulfillmentType == 'ON_SITE_RESCUE' && after.status == 'DELIVERED')
          || (before.status == 'READY_FOR_PICKUP' && after.status in ['DELIVERED', 'CANCELLED'])
          || (before.status == 'SHIPPING' && after.status == 'DELIVERED');
    }

    function validLifecyclePayment(before, after) {
      return (after.status == 'DELIVERED'
            && ((before.paymentMethod == 'BANK_TRANSFER' && before.paymentStatus == 'PAID' && after.paymentStatus == 'PAID')
              || (before.paymentMethod in ['COD', 'CASH_ON_SITE'] && after.paymentStatus == 'PAID')))
          || (after.status == 'CANCELLED' && before.paymentStatus != 'PAID' && after.paymentStatus == 'FAILED')
          || (!(after.status in ['DELIVERED', 'CANCELLED']) && after.paymentStatus == before.paymentStatus);
    }

    function lifecycleOrderUpdate(before, after) {
      let terminal = after.status in ['DELIVERED', 'CANCELLED'];
      return lifecycleActor(before) && legalOrderStatusTransition(before, after)
          && validLifecyclePayment(before, after)
          && after.inventoryFinalized == terminal
          && after.finalizedStatus == (terminal ? after.status : '')
          && after.diff(before).affectedKeys().hasOnly([
            'status', 'paymentStatus', 'inventoryFinalized', 'finalizedStatus', 'updatedAt'
          ]);
    }

    function bankConfirmationOrderUpdate(before, after) {
      return lifecycleActor(before) && before.paymentMethod == 'BANK_TRANSFER'
          && before.paymentStatus == 'PENDING' && after.paymentStatus == 'PAID'
          && before.status != 'CANCELLED' && after.status == before.status
          && after.diff(before).affectedKeys().hasOnly(['paymentStatus', 'updatedAt']);
    }

    function lifecycleBatchMutation(before, after, batchId) {
      let orderId = after.lastLifecycleOrderId;
      let oldOrder = get(/databases/$(database)/documents/orders/$(orderId)).data;
      let order = getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
      let quantity = order.batchReservations[batchId];
      return lifecycleActor(oldOrder) && order.inventoryFinalized == true
          && order.status in ['DELIVERED', 'CANCELLED']
          && quantity is number && quantity > 0
          && after.reservedQuantity == before.reservedQuantity - quantity
          && after.availableQuantity == before.availableQuantity
              + (order.status == 'CANCELLED' ? quantity : 0)
          && after.soldQuantity == before.soldQuantity
              + (order.status == 'DELIVERED' ? quantity : 0)
          && after.initialQuantity == before.initialQuantity
          && after.inventoryVersion == before.inventoryVersion + 1
          && after.lastLifecycleAction == order.status
          && after.lastLifecycleQuantity == quantity
          && after.diff(before).affectedKeys().hasOnly([
            'availableQuantity', 'reservedQuantity', 'soldQuantity', 'status', 'inventoryVersion',
            'lastLifecycleOrderId', 'lastLifecycleAction', 'lastLifecycleQuantity', 'updatedAt'
          ]);
    }

    function lifecycleCampaignMutation(before, after) {
      let orderId = after.lastLifecycleOrderId;
      let oldOrder = get(/databases/$(database)/documents/orders/$(orderId)).data;
      let order = getAfter(/databases/$(database)/documents/orders/$(orderId)).data;
      let quantity = order.campaignReservedQuantity;
      return lifecycleActor(oldOrder) && order.inventoryFinalized == true
          && order.campaignId == before.id && order.status in ['DELIVERED', 'CANCELLED']
          && quantity is number && quantity > 0
          && after.reservedQuantity == before.reservedQuantity - quantity
          && after.rescuedQuantity == before.rescuedQuantity
              + (order.status == 'DELIVERED' ? quantity : 0)
          && after.lastLifecycleAction == order.status
          && after.lastLifecycleQuantity == quantity
          && after.diff(before).affectedKeys().hasOnly([
            'reservedQuantity', 'rescuedQuantity', 'status', 'lastLifecycleOrderId',
            'lastLifecycleAction', 'lastLifecycleQuantity', 'updatedAt'
          ]);
    }

    function validInventoryTransition(before, after) {
      return (before.reservedQuantity == 0
              && before.soldQuantity == 0
              && after.reservedQuantity == 0
              && after.soldQuantity == 0
              && after.availableQuantity == after.initialQuantity)
          || (after.soldQuantity == before.soldQuantity
              && before.availableQuantity - after.availableQuantity
                  - (after.reservedQuantity - before.reservedQuantity) <= 0.000001
              && before.availableQuantity - after.availableQuantity
                  - (after.reservedQuantity - before.reservedQuantity) >= -0.000001
              && (after.availableQuantity >= before.availableQuantity
                  || before.expiryDate > request.time))
          || (after.availableQuantity == before.availableQuantity
              && before.reservedQuantity - after.reservedQuantity
                  - (after.soldQuantity - before.soldQuantity) <= 0.000001
              && before.reservedQuantity - after.reservedQuantity
                  - (after.soldQuantity - before.soldQuantity) >= -0.000001);
    }

    function validCampaign(data) {
      return data.id is string
          && data.sellerId is string
          && data.title is string
          && data.title.size() >= 3
          && data.rescueReason in [
            'OVER_SUPPLY', 'NEAR_EXPIRY', 'SEASONAL_HARVEST', 'WEATHER_IMPACT',
            'ORDER_CANCELLED', 'LOGISTICS_DISRUPTION', 'DEMAND_DROP', 'COSMETIC_GRADE'
          ]
          && data.urgencyLevel in ['NORMAL', 'HIGH', 'CRITICAL']
          && data.rescueMode in ['FIXED_POINT', 'MOBILE_POINT']
          && data.batchTargets is map
          && data.batchTargets.size() > 0
          && data.batchTargets.size() <= 8
          && data.targetQuantity is number
          && data.targetQuantity > 0
          && data.reservedQuantity is number
          && data.rescuedQuantity is number
          && data.reservedQuantity >= 0
          && data.rescuedQuantity >= 0
          && data.reservedQuantity + data.rescuedQuantity <= data.targetQuantity + 0.000001
          && data.startDate is timestamp
          && data.endDate is timestamp
          && data.startDate < data.endDate
          && data.latitude is number
          && data.latitude >= -90 && data.latitude <= 90
          && data.longitude is number
          && data.longitude >= -180 && data.longitude <= 180
          && data.currentLatitude is number
          && data.currentLatitude >= -90 && data.currentLatitude <= 90
          && data.currentLongitude is number
          && data.currentLongitude >= -180 && data.currentLongitude <= 180
          && (data.locationUpdatedAt == null || data.locationUpdatedAt is timestamp)
          && data.locationSharingEnabled is bool
          && (data.rescueMode == 'MOBILE_POINT' || data.locationSharingEnabled == false)
          && data.locationName is string
          && data.status in [
            'DRAFT', 'PENDING_APPROVAL', 'ACTIVE', 'COMPLETED', 'EXPIRED', 'REJECTED', 'STOPPED'
          ];
    }

    function validCampaignProgressTransition(before, after) {
      return (after.rescuedQuantity == before.rescuedQuantity
              && after.reservedQuantity >= before.reservedQuantity)
          || (after.reservedQuantity <= before.reservedQuantity
              && after.rescuedQuantity - before.rescuedQuantity
                  - (before.reservedQuantity - after.reservedQuantity) <= 0.000001
              && after.rescuedQuantity - before.rescuedQuantity
                  - (before.reservedQuantity - after.reservedQuantity) >= -0.000001)
          || (after.rescuedQuantity == before.rescuedQuantity
              && after.reservedQuantity <= before.reservedQuantity);
    }

    function validPost(data) {
      return data.id is string
          && data.sellerId is string
          && data.title is string
          && data.title.size() >= 3 && data.title.size() <= 120
          && data.content is string
          && data.content.size() >= 10 && data.content.size() <= 3000
          && data.campaignId is string
          && data.imageUrls is list && data.imageUrls.size() <= 6
          && data.linkedProductIds is list && data.linkedProductIds.size() <= 12
          && data.urgencyLevel in ['NORMAL', 'HIGH', 'CRITICAL']
          && data.status in ['DRAFT', 'PENDING_APPROVAL', 'PUBLISHED', 'REJECTED', 'HIDDEN']
          && data.viewCount is int && data.viewCount >= 0
          && data.createdAt is timestamp;
    }

    function publishedPost(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data.status == 'PUBLISHED';
    }

    function validComment(data, postId) {
      return data.id is string
          && data.postId == postId
          && data.userId is string
          && data.status in ['ACTIVE', 'EDITED', 'DELETED', 'HIDDEN']
          && data.content is string
          && ((data.status == 'DELETED' && data.content == '')
            || (data.status != 'DELETED' && data.content.size() >= 1 && data.content.size() <= 500))
          && data.createdAt is timestamp
          && data.updatedAt is timestamp;
    }

    function hasNoCredentialFields(data) {
      return !data.keys().hasAny(['password', 'passwordHash', 'rawPassword']);
    }

    function hasValidSelfRegistrationRole(data) {
      return data.role == 'CUSTOMER'
          || (data.role == 'SELLER' && data.sellerStatus == 'PENDING_APPROVAL');
    }

    function validAddress(data, userId) {
      return data.customerId == userId
          && data.receiverName is string
          && data.receiverName.size() >= 2
          && data.receiverPhone is string
          && data.receiverPhone.size() >= 9
          && data.province is string
          && data.district is string
          && data.ward is string
          && data.street is string
          && data.type in ['HOME', 'WORK', 'OTHER']
          && data.isDefault is bool
          && data.latitude is number
          && data.latitude >= -90
          && data.latitude <= 90
          && data.longitude is number
          && data.longitude >= -180
          && data.longitude <= 180;
    }

    match /users/{userId} {
      allow create: if isOwner(userId)
          && request.resource.data.id == userId
          && request.resource.data.status == 'ACTIVE'
          && hasValidSelfRegistrationRole(request.resource.data)
          && hasNoCredentialFields(request.resource.data);

      allow get: if isOwner(userId);
      allow list: if false;

      allow update: if isOwner(userId)
          && request.resource.data.id == resource.data.id
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && (resource.data.role != 'SELLER'
              || request.resource.data.sellerStatus == resource.data.sellerStatus)
          && (resource.data.role == 'SELLER'
              || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                'representativeName', 'shopName', 'shopDescription', 'shopAvatarUrl', 'address'
              ]))
          && hasNoCredentialFields(request.resource.data);

      allow delete: if false;

      match /addresses/{addressId} {
        allow get, list: if hasRole(userId, 'CUSTOMER');
        allow create: if hasRole(userId, 'CUSTOMER')
            && request.resource.data.id == addressId
            && validAddress(request.resource.data, userId)
            && hasNoCredentialFields(request.resource.data);
        allow update: if hasRole(userId, 'CUSTOMER')
            && request.resource.data.id == resource.data.id
            && request.resource.data.customerId == resource.data.customerId
            && validAddress(request.resource.data, userId)
            && hasNoCredentialFields(request.resource.data);
        allow delete: if hasRole(userId, 'CUSTOMER') && resource.data.isDefault == false;
      }
    }

    match /sellerApplications/{sellerId} {
      allow get: if hasRole(sellerId, 'SELLER');
      allow list: if false;
      allow create: if hasRole(sellerId, 'SELLER')
          && request.resource.data.id == sellerId
          && request.resource.data.sellerId == sellerId
          && request.resource.data.status == 'PENDING'
          && hasNoCredentialFields(request.resource.data);
      allow update: if hasRole(sellerId, 'SELLER')
          && resource.data.status == 'REJECTED'
          && request.resource.data.id == resource.data.id
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status == 'PENDING'
          && hasNoCredentialFields(request.resource.data);
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow get, list: if resource.data.active == true;
      allow write: if false;
    }

    match /products/{productId} {
      allow get, list: if resource.data.status == 'ACTIVE'
          || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow create: if isApprovedSeller(request.auth.uid)
          && request.resource.data.id == productId
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.averageRating == 0
          && request.resource.data.reviewCount == 0
          && validProduct(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow update: if isApprovedSeller(request.auth.uid)
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.averageRating == resource.data.averageRating
          && request.resource.data.reviewCount == resource.data.reviewCount
          && validProduct(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow delete: if false;
    }

    match /productBatches/{batchId} {
      allow get, list: if true;
      allow create: if isApprovedSeller(request.auth.uid)
          && ownsProduct(request.resource.data.productId)
          && request.resource.data.id == batchId
          && request.resource.data.inventoryVersion == 1
          && validBatch(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow update: if (isApprovedSeller(request.auth.uid)
            && ownsProduct(resource.data.productId)
            && request.resource.data.id == resource.data.id
            && request.resource.data.productId == resource.data.productId
            && request.resource.data.inventoryVersion == resource.data.inventoryVersion + 1
            && validBatch(request.resource.data)
            && validInventoryTransition(resource.data, request.resource.data)
            && hasNoCredentialFields(request.resource.data))
          || (checkoutBatchReservation(resource.data, request.resource.data, batchId)
            && validBatch(request.resource.data))
          || (lifecycleBatchMutation(resource.data, request.resource.data, batchId)
            && validBatch(request.resource.data));
      allow delete: if isApprovedSeller(request.auth.uid)
          && ownsProduct(resource.data.productId)
          && resource.data.reservedQuantity == 0
          && resource.data.soldQuantity == 0
          && (resource.data.activeCampaignId == null || resource.data.activeCampaignId == '');
    }

    match /promotions/{promotionId} {
      allow get: if true;
      allow list: if (resource.data.active == true
            && resource.data.startDate <= request.time
            && resource.data.endDate > request.time)
          || (isSignedIn() && resource.data.sellerId == request.auth.uid)
          || isAdmin();
      allow create: if isApprovedSeller(request.auth.uid)
          && promotionId == request.resource.data.productId
          && request.resource.data.sellerId == request.auth.uid
          && ownsProduct(request.resource.data.productId)
          && validPromotion(request.resource.data, promotionId)
          && hasNoCredentialFields(request.resource.data);
      allow update: if isApprovedSeller(request.auth.uid)
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.productId == resource.data.productId
          && ownsProduct(resource.data.productId)
          && validPromotion(request.resource.data, promotionId)
          && hasNoCredentialFields(request.resource.data);
      allow delete: if false;
    }

    match /customerCarts/{customerId} {
      allow get: if hasRole(customerId, 'CUSTOMER');
      allow list: if false;
      allow create, update: if hasRole(customerId, 'CUSTOMER')
          && validCustomerCart(request.resource.data, customerId);
      allow delete: if hasRole(customerId, 'CUSTOMER');
    }

    match /orders/{orderId} {
      allow get, list: if (isSignedIn() && resource.data.ownerType == 'CUSTOMER'
            && resource.data.ownerId == request.auth.uid)
          || resource.data.ownerType == 'GUEST'
          || (isSignedIn() && resource.data.sellerId == request.auth.uid)
          || isAdmin();
      allow create: if validOrder(request.resource.data, orderId)
          && checkoutOwnerAllowed(request.resource.data)
          && !exists(/databases/$(database)/documents/orders/$(orderId));
      allow update: if lifecycleOrderUpdate(resource.data, request.resource.data)
          || bankConfirmationOrderUpdate(resource.data, request.resource.data);
      allow delete: if false;
      match /items/{itemId} {
        allow get, list: if (isSignedIn()
              && get(/databases/$(database)/documents/orders/$(orderId)).data.ownerId == request.auth.uid)
            || get(/databases/$(database)/documents/orders/$(orderId)).data.ownerType == 'GUEST';
        allow create: if getAfter(/databases/$(database)/documents/orders/$(orderId)).data.status == 'PENDING'
            && checkoutOwnerAllowed(getAfter(/databases/$(database)/documents/orders/$(orderId)).data)
            && request.resource.data.id == itemId && request.resource.data.orderId == orderId
            && request.resource.data.batchId == itemId
            && request.resource.data.quantity is number && request.resource.data.quantity > 0
            && request.resource.data.finalPriceSnapshot is number
            && request.resource.data.finalPriceSnapshot >= 0;
        allow update, delete: if false;
      }
    }

    match /payments/{paymentId} {
      allow get: if get(/databases/$(database)/documents/orders/$(paymentId)).data.ownerType == 'GUEST'
          || (isSignedIn() && (get(/databases/$(database)/documents/orders/$(paymentId)).data.ownerId == request.auth.uid
            || get(/databases/$(database)/documents/orders/$(paymentId)).data.sellerId == request.auth.uid))
          || isAdmin();
      allow list: if false;
      allow create: if paymentId == request.resource.data.orderId
          && request.resource.data.id == paymentId
          && request.resource.data.amount == getAfter(/databases/$(database)/documents/orders/$(paymentId)).data.totalAmount
          && request.resource.data.method == getAfter(/databases/$(database)/documents/orders/$(paymentId)).data.paymentMethod
          && request.resource.data.status == getAfter(/databases/$(database)/documents/orders/$(paymentId)).data.paymentStatus
          && checkoutOwnerAllowed(getAfter(/databases/$(database)/documents/orders/$(paymentId)).data);
      allow update: if request.resource.data.id == resource.data.id
          && request.resource.data.orderId == resource.data.orderId
          && request.resource.data.method == resource.data.method
          && request.resource.data.amount == resource.data.amount
          && (
            (resource.data.method == 'BANK_TRANSFER' && resource.data.status == 'PENDING'
              && request.resource.data.status == 'PAID'
              && request.resource.data.referenceCode is string
              && request.resource.data.referenceCode.size() >= 3
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'referenceCode', 'paidAt', 'updatedAt'
              ])
              && bankConfirmationOrderUpdate(
                get(/databases/$(database)/documents/orders/$(paymentId)).data,
                getAfter(/databases/$(database)/documents/orders/$(paymentId)).data))
            || (lifecycleActor(get(/databases/$(database)/documents/orders/$(paymentId)).data)
              && request.resource.data.status == getAfter(/databases/$(database)/documents/orders/$(paymentId)).data.paymentStatus
              && getAfter(/databases/$(database)/documents/orders/$(paymentId)).data.status in ['DELIVERED', 'CANCELLED']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'paidAt', 'updatedAt'
              ]))
          );
      allow delete: if false;
    }

    match /shipments/{shipmentId} {
      allow get: if get(/databases/$(database)/documents/orders/$(shipmentId)).data.ownerType == 'GUEST'
          || (isSignedIn() && (get(/databases/$(database)/documents/orders/$(shipmentId)).data.ownerId == request.auth.uid
            || get(/databases/$(database)/documents/orders/$(shipmentId)).data.sellerId == request.auth.uid))
          || isAdmin();
      allow list: if false;
      allow create: if shipmentId == request.resource.data.orderId
          && request.resource.data.id == shipmentId && request.resource.data.status == 'PENDING'
          && getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data.fulfillmentType == 'DELIVERY'
          && checkoutOwnerAllowed(getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data);
      allow update: if lifecycleActor(get(/databases/$(database)/documents/orders/$(shipmentId)).data)
          && request.resource.data.id == resource.data.id
          && request.resource.data.orderId == resource.data.orderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && ((getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data.status == 'PREPARING'
                && request.resource.data.status == 'READY')
            || (getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data.status == 'SHIPPING'
                && request.resource.data.status == 'SHIPPING')
            || (getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data.status == 'DELIVERED'
                && request.resource.data.status == 'DELIVERED')
            || (getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data.status == 'CANCELLED'
                && request.resource.data.status == 'CANCELLED')
            || (getAfter(/databases/$(database)/documents/orders/$(shipmentId)).data.status in ['PENDING', 'CONFIRMED']
                && request.resource.data.status == 'PENDING'));
      allow delete: if false;
    }

    match /campaigns/{campaignId} {
      allow get, list: if resource.data.status == 'ACTIVE'
          || (isSignedIn() && resource.data.sellerId == request.auth.uid)
          || isAdmin();
      allow create: if isApprovedSeller(request.auth.uid)
          && request.resource.data.id == campaignId
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.status in ['DRAFT', 'PENDING_APPROVAL']
          && request.resource.data.reservedQuantity == 0
          && request.resource.data.rescuedQuantity == 0
          && validCampaign(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow update: if (
            (isApprovedSeller(request.auth.uid)
              && resource.data.sellerId == request.auth.uid
              && resource.data.status in ['DRAFT', 'REJECTED']
              && request.resource.data.status in ['DRAFT', 'PENDING_APPROVAL']
              && request.resource.data.reservedQuantity == resource.data.reservedQuantity
              && request.resource.data.rescuedQuantity == resource.data.rescuedQuantity)
            || (isApprovedSeller(request.auth.uid)
              && resource.data.sellerId == request.auth.uid
              && resource.data.status == 'ACTIVE'
              && resource.data.rescueMode == 'MOBILE_POINT'
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'currentLatitude', 'currentLongitude', 'locationUpdatedAt',
                'locationSharingEnabled', 'updatedAt'
              ])
              && (request.resource.data.locationSharingEnabled == false
                || request.resource.data.locationUpdatedAt == request.time))
            || (isApprovedSeller(request.auth.uid)
              && resource.data.sellerId == request.auth.uid
              && resource.data.status == 'ACTIVE'
              && request.resource.data.status in ['ACTIVE', 'COMPLETED']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'reservedQuantity', 'rescuedQuantity', 'status', 'updatedAt'
              ])
              && validCampaignProgressTransition(resource.data, request.resource.data))
            || (checkoutCampaignReservation(resource.data, request.resource.data))
            || (lifecycleCampaignMutation(resource.data, request.resource.data))
            || (isAdmin()
              && resource.data.status == 'PENDING_APPROVAL'
              && request.resource.data.status in ['ACTIVE', 'REJECTED']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'status', 'urgencyLevel', 'updatedAt'
              ]))
          )
          && request.resource.data.id == resource.data.id
          && request.resource.data.sellerId == resource.data.sellerId
          && validCampaign(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow delete: if false;
    }

    match /banners/{bannerId} {
      allow get, list: if resource.data.active == true;
      allow create, update, delete: if false;
    }

    match /posts/{postId} {
      allow get, list: if resource.data.status == 'PUBLISHED'
          || (isSignedIn() && resource.data.sellerId == request.auth.uid)
          || isAdmin();
      allow create: if isApprovedSeller(request.auth.uid)
          && request.resource.data.id == postId
          && request.resource.data.sellerId == request.auth.uid
          && request.resource.data.status in ['DRAFT', 'PENDING_APPROVAL']
          && request.resource.data.viewCount == 0
          && validPost(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow update: if (
            (isApprovedSeller(request.auth.uid)
              && resource.data.sellerId == request.auth.uid
              && resource.data.status in ['DRAFT', 'REJECTED']
              && request.resource.data.status in ['DRAFT', 'PENDING_APPROVAL']
              && request.resource.data.id == resource.data.id
              && request.resource.data.sellerId == resource.data.sellerId
              && request.resource.data.createdAt == resource.data.createdAt
              && request.resource.data.viewCount == resource.data.viewCount)
            || (isAdmin()
              && resource.data.status == 'PENDING_APPROVAL'
              && request.resource.data.status in ['PUBLISHED', 'REJECTED']
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
          )
          && validPost(request.resource.data)
          && hasNoCredentialFields(request.resource.data);
      allow delete: if false;

      match /reactions/{reactionId} {
        allow get, list: if publishedPost(postId);
        allow create: if isSignedIn() && publishedPost(postId)
            && reactionId == request.auth.uid
            && request.resource.data.id == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.postId == postId
            && request.resource.data.type in ['LIKE', 'SUPPORT', 'CARE']
            && request.resource.data.createdAt is timestamp;
        allow update: if isOwner(reactionId) && publishedPost(postId)
            && request.resource.data.id == resource.data.id
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.postId == resource.data.postId
            && request.resource.data.type in ['LIKE', 'SUPPORT', 'CARE']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'createdAt']);
        allow delete: if isOwner(reactionId);
      }

      match /comments/{commentId} {
        allow get, list: if publishedPost(postId);
        allow create: if isSignedIn() && publishedPost(postId)
            && request.resource.data.id == commentId
            && request.resource.data.userId == request.auth.uid
            && request.resource.data.status == 'ACTIVE'
            && validComment(request.resource.data, postId);
        allow update: if isSignedIn() && resource.data.userId == request.auth.uid
            && resource.data.status in ['ACTIVE', 'EDITED']
            && request.resource.data.id == resource.data.id
            && request.resource.data.userId == resource.data.userId
            && request.resource.data.postId == resource.data.postId
            && request.resource.data.status in ['EDITED', 'DELETED']
            && validComment(request.resource.data, postId);
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
